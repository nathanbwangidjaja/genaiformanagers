generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  TEACHER
  STUDENT
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String
  lastName  String
  role      Role
  createdAt DateTime @default(now())

  teacherClasses Class[]            @relation("ClassTeacher")
  studentClasses ClassEnrollment[]
  studentProfile StudentProfile?
  lessonPlans    LessonPlan[]
}

model Class {
  id         String   @id @default(cuid())
  name       String
  gradeLevel Int      @default(7)
  inviteCode String   @unique
  teacherId  String
  teacher    User     @relation("ClassTeacher", fields: [teacherId], references: [id])
  createdAt  DateTime @default(now())

  enrollments ClassEnrollment[]
  assignments Assignment[]
  lessonPlans LessonPlan[]
}

// Saved AI-generated lesson plans
model LessonPlan {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id])
  classId   String?
  class     Class?   @relation(fields: [classId], references: [id])
  title     String
  content   Json     // Full LessonPlan object (sections, criteria, etc.)
  focusNotes String?
  createdAt DateTime @default(now())

  @@index([teacherId, createdAt])
}

model ClassEnrollment {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  joinedAt  DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id])
  student   User     @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId])
}

enum MathDomain {
  RATIOS_PROPORTIONAL
  NUMBER_SYSTEM
  EXPRESSIONS_EQUATIONS
  GEOMETRY
  STATISTICS_PROBABILITY
}

enum NodeDepth {
  DOMAIN
  CLUSTER
  STANDARD
  SKILL
}

enum BloomLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

enum PrereqType {
  HARD
  SOFT
  RELATED
}

model CurriculumNode {
  id                 String      @id @default(cuid())
  code               String      @unique
  name               String
  description        String?
  domain             MathDomain
  depth              NodeDepth
  gradeLevel         Int         @default(7)
  difficultyBaseline Float       @default(3.0)
  bloomLevel         BloomLevel?
  parentId           String?
  parent             CurriculumNode? @relation("NodeHierarchy", fields: [parentId], references: [id])
  children           CurriculumNode[] @relation("NodeHierarchy")

  prerequisites  CurriculumPrerequisite[] @relation("PrereqTarget")
  dependents     CurriculumPrerequisite[] @relation("PrereqSource")
  questions      Question[]
  masteryRecords StudentConceptMastery[]
}

model CurriculumPrerequisite {
  id               String         @id @default(cuid())
  sourceNodeId     String
  targetNodeId     String
  strength         Float          @default(1.0)
  relationshipType PrereqType     @default(HARD)
  sourceNode       CurriculumNode @relation("PrereqSource", fields: [sourceNodeId], references: [id])
  targetNode       CurriculumNode @relation("PrereqTarget", fields: [targetNodeId], references: [id])

  @@unique([sourceNodeId, targetNodeId])
}

enum QuestionType {
  MULTIPLE_CHOICE
  FREE_RESPONSE
  STEP_BY_STEP
}

enum QuestionFormat {
  COMPUTATION
  WORD_PROBLEM
  VISUAL
  MULTI_STEP
  CONCEPT
}

enum CognitiveDemand {
  RECALL      // remember a fact / formula
  APPLY       // execute a known procedure
  ANALYZE     // pull apart relationships
  EVALUATE    // judge / compare
  CREATE      // construct novel solution
}

model Question {
  id               String          @id @default(cuid())
  curriculumNodeId String
  curriculumNode   CurriculumNode  @relation(fields: [curriculumNodeId], references: [id])
  content          Json            // {text, options[], correctAnswer, media?}
  questionType     QuestionType
  format           QuestionFormat  @default(COMPUTATION)
  cognitiveDemand  CognitiveDemand @default(APPLY)
  difficulty       Float           @default(3.0)
  expectedTimeSec  Int             @default(120)
  commonErrors     Json?           // {answerValue: errorType}
  hints            Json?           // string[]
  createdById      String?
  createdAt        DateTime        @default(now())

  assignmentQuestions AssignmentQuestion[]
  interactions        InteractionEvent[]
  responses           SubmissionResponse[]
}

model Assignment {
  id          String    @id @default(cuid())
  classId     String
  class       Class     @relation(fields: [classId], references: [id])
  title       String
  description String?
  dueDate     DateTime?
  isAdaptive  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  questions   AssignmentQuestion[]
  submissions Submission[]
}

model AssignmentQuestion {
  id           String     @id @default(cuid())
  assignmentId String
  questionId   String
  orderIndex   Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  question     Question   @relation(fields: [questionId], references: [id])

  @@unique([assignmentId, questionId])
}

model Submission {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  score        Float?
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  responses    SubmissionResponse[]
}

model SubmissionResponse {
  id            String   @id @default(cuid())
  submissionId  String
  questionId    String
  answer        Json
  isCorrect     Boolean
  timeSpentMs   Int
  hintsUsed     Int      @default(0)
  attemptNumber Int      @default(1)
  errorType     String?
  submission    Submission @relation(fields: [submissionId], references: [id])
  question      Question   @relation(fields: [questionId], references: [id])
}

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Legacy aggregate tables — kept while we migrate reads to the KG.
  masteryRecords    StudentConceptMastery[]
  behavioralProfile StudentBehavioralProfile?
  insight           StudentInsight?
  interactionEvents InteractionEvent[]
  sessions          LearningSession[]

  // Knowledge graph — the new source of truth.
  kgNodes KGNode[]
  kgEdges KGEdge[]
}

// =============================================================================
// KNOWLEDGE GRAPH — per-student, append-only, the source of truth for the
// student's cognitive profile. All node types live in one table; all edge
// types in another. The `props` JSON carries type-specific data + cached
// aggregates (e.g. concept node carries the current mastery as a prop so the
// real-time loop doesn't have to traverse the graph to read mastery).
//
// Node types:
//   concept           — a Common Core standard the student has touched
//                       props: { code, name, domain, mastery, confidence,
//                                totalAttempts, correctAttempts, hintRate,
//                                streak, lastPracticedAt, weaknessCategory,
//                                flowFraction, errorPatternCounts }
//   attempt           — one question_attempt event
//                       props: { isCorrect, timeMs, hintsUsed, errorType }
//   question          — a question seen by this student
//                       props: { questionId, text, difficulty, format }
//   tutor_message     — student's message to the AI tutor
//                       props: { text, intent, confidence }
//   misconception     — recurring error pattern (extracted)
//                       props: { errorType, conceptId, occurrenceCount, firstSeen }
//   strength          — sustained success pattern (extracted)
//                       props: { conceptId, evidenceType }
//   curiosity_thread  — cluster of conceptual_why questions (extracted)
//                       props: { topic, messageIds }
//   behavior          — aggregate behavioral score (curiosity, motivation, etc.)
//                       props: { kind, value, signals }
//   trait             — inferred cognitive trait
//                       props: { name, value, confidence, evidence }
//   session           — a learning session
//                       props: { startedAt, endedAt, type }
//   insight           — AI-generated teacher brief snapshot
//                       props: { summary, highlights, recommendations }
//
// Edge types:
//   practiced_in      — attempt → concept
//   instance_of       — attempt → question
//   tested_by         — question → concept
//   prerequisite_of   — concept → concept (curriculum)
//   asked_about       — tutor_message → concept
//   evidences         — attempt → misconception
//   demonstrates      — attempt → strength
//   manifests_in      — trait → concept
//   contributes_to    — attempt → behavior
//   during            — attempt or tutor_message → session
//   confused_about    — tutor_message → concept (intent = expressing_confusion)
//   understood        — tutor_message → concept (intent = expressing_understanding)
//   references        — insight → any node
// =============================================================================

model KGNode {
  id        String   @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type      String
  label     String
  // For concept nodes: external key (= curriculumNodeId). For question nodes:
  // the underlying Question.id. Lets us upsert-by-(studentId, type, externalKey)
  // without scanning props.
  externalKey String?
  props     Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outEdges KGEdge[] @relation("from")
  inEdges  KGEdge[] @relation("to")

  @@index([studentId, type])
  @@index([studentId, createdAt])
  @@unique([studentId, type, externalKey])
}

model KGEdge {
  id        String   @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromId    String
  toId      String
  type      String
  weight    Float    @default(1.0)
  props     Json     @default("{}")
  createdAt DateTime @default(now())

  from KGNode @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  to   KGNode @relation("to",   fields: [toId],   references: [id], onDelete: Cascade)

  @@index([studentId, type])
  @@index([fromId])
  @@index([toId])
}

enum WeaknessCategory {
  SOLID                 // high mastery, low hints, low conceptual errors
  MEMORIZED_FRAGILE     // high mastery but high hint usage — passes when scaffolded
  CONCEPTUALLY_WEAK     // low mastery + dominant conceptual errors — needs reteaching
  PROCEDURALLY_WEAK     // low mastery + dominant computational errors — needs practice
  CARELESS              // mid mastery + dominant careless errors — needs slow-down strategy
  UNTESTED              // not enough data
}

model StudentConceptMastery {
  id                 String           @id @default(cuid())
  studentId          String
  curriculumNodeId   String
  masteryLevel       Float            @default(0.0)
  confidence         Float            @default(0.0)
  totalAttempts      Int              @default(0)
  correctAttempts    Int              @default(0)
  avgTimePerQuestion Float?
  errorPatternCounts Json             @default("{}")
  hintUsageRate      Float            @default(0.0)
  lastPracticedAt    DateTime?
  streak             Int              @default(0)
  decayFactor        Float            @default(0.05)
  weaknessCategory   WeaknessCategory @default(UNTESTED)
  flowFraction       Float            @default(0.0) // fraction of attempts in challenge-skill sweet spot
  updatedAt          DateTime         @updatedAt

  student        StudentProfile @relation(fields: [studentId], references: [id])
  curriculumNode CurriculumNode @relation(fields: [curriculumNodeId], references: [id])

  @@unique([studentId, curriculumNodeId])
  @@index([studentId])
  @@index([curriculumNodeId])
}

model StudentBehavioralProfile {
  id                String   @id @default(cuid())
  studentId         String   @unique
  curiosityScore    Float    @default(0.5)
  motivationScore   Float    @default(0.5)
  engagementScore   Float    @default(0.5)
  persistenceScore  Float    @default(0.5)
  flowScore         Float    @default(0.0) // composite flow state index 0-1
  curiositySignals  Json     @default("{}")
  motivationSignals Json     @default("{}")
  engagementSignals Json     @default("{}")
  flowSignals       Json     @default("{}")
  cognitiveTraits   Json     @default("[]") // [{trait, value, confidence, evidence}]
  tutorIntents      Json     @default("{}") // counts by intent type
  window30d         Json     @default("{}")
  updatedAt         DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id])
}

// AI-generated teacher-facing insight summary, cached per student
model StudentInsight {
  id          String         @id @default(cuid())
  studentId   String         @unique
  student     StudentProfile @relation(fields: [studentId], references: [id])
  summary     String         // 2-3 sentence overview
  highlights  Json           // [{type: "strength|risk|curiosity|growth", text}]
  recommendations Json       // [{action, why}]
  modelInputHash String      // sha256 of the input data — used to invalidate when stale
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model InteractionEvent {
  id         String   @id @default(cuid())
  studentId  String
  sessionId  String?
  eventType  String
  timestamp  DateTime @default(now())
  questionId String?
  payload    Json

  student  StudentProfile   @relation(fields: [studentId], references: [id])
  question Question?        @relation(fields: [questionId], references: [id])
  session  LearningSession? @relation(fields: [sessionId], references: [id])

  @@index([studentId, timestamp])
  @@index([studentId, eventType])
}

model LearningSession {
  id           String    @id @default(cuid())
  studentId    String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  assignmentId String?
  sessionType  String

  student StudentProfile     @relation(fields: [studentId], references: [id])
  events  InteractionEvent[]

  @@index([studentId, startedAt])
}
