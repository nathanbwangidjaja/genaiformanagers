generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  TEACHER
  STUDENT
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String
  lastName  String
  role      Role
  createdAt DateTime @default(now())

  teacherClasses Class[]            @relation("ClassTeacher")
  studentClasses ClassEnrollment[]
  studentProfile StudentProfile?
}

model Class {
  id         String   @id @default(cuid())
  name       String
  gradeLevel Int      @default(7)
  inviteCode String   @unique
  teacherId  String
  teacher    User     @relation("ClassTeacher", fields: [teacherId], references: [id])
  createdAt  DateTime @default(now())

  enrollments ClassEnrollment[]
  assignments Assignment[]
}

model ClassEnrollment {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  joinedAt  DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id])
  student   User     @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId])
}

enum MathDomain {
  RATIOS_PROPORTIONAL
  NUMBER_SYSTEM
  EXPRESSIONS_EQUATIONS
  GEOMETRY
  STATISTICS_PROBABILITY
}

enum NodeDepth {
  DOMAIN
  CLUSTER
  STANDARD
  SKILL
}

enum BloomLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

enum PrereqType {
  HARD
  SOFT
  RELATED
}

model CurriculumNode {
  id                 String      @id @default(cuid())
  code               String      @unique
  name               String
  description        String?
  domain             MathDomain
  depth              NodeDepth
  gradeLevel         Int         @default(7)
  difficultyBaseline Float       @default(3.0)
  bloomLevel         BloomLevel?
  parentId           String?
  parent             CurriculumNode? @relation("NodeHierarchy", fields: [parentId], references: [id])
  children           CurriculumNode[] @relation("NodeHierarchy")

  prerequisites  CurriculumPrerequisite[] @relation("PrereqTarget")
  dependents     CurriculumPrerequisite[] @relation("PrereqSource")
  questions      Question[]
  masteryRecords StudentConceptMastery[]
}

model CurriculumPrerequisite {
  id               String         @id @default(cuid())
  sourceNodeId     String
  targetNodeId     String
  strength         Float          @default(1.0)
  relationshipType PrereqType     @default(HARD)
  sourceNode       CurriculumNode @relation("PrereqSource", fields: [sourceNodeId], references: [id])
  targetNode       CurriculumNode @relation("PrereqTarget", fields: [targetNodeId], references: [id])

  @@unique([sourceNodeId, targetNodeId])
}

enum QuestionType {
  MULTIPLE_CHOICE
  FREE_RESPONSE
  STEP_BY_STEP
}

model Question {
  id               String         @id @default(cuid())
  curriculumNodeId String
  curriculumNode   CurriculumNode @relation(fields: [curriculumNodeId], references: [id])
  content          Json           // {text, options[], correctAnswer, media?}
  questionType     QuestionType
  difficulty       Float          @default(3.0)
  expectedTimeSec  Int            @default(120)
  commonErrors     Json?          // {answerValue: errorType}
  hints            Json?          // string[]
  createdById      String?
  createdAt        DateTime       @default(now())

  assignmentQuestions AssignmentQuestion[]
  interactions        InteractionEvent[]
  responses           SubmissionResponse[]
}

model Assignment {
  id          String    @id @default(cuid())
  classId     String
  class       Class     @relation(fields: [classId], references: [id])
  title       String
  description String?
  dueDate     DateTime?
  isAdaptive  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  questions   AssignmentQuestion[]
  submissions Submission[]
}

model AssignmentQuestion {
  id           String     @id @default(cuid())
  assignmentId String
  questionId   String
  orderIndex   Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  question     Question   @relation(fields: [questionId], references: [id])

  @@unique([assignmentId, questionId])
}

model Submission {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  score        Float?
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  responses    SubmissionResponse[]
}

model SubmissionResponse {
  id            String   @id @default(cuid())
  submissionId  String
  questionId    String
  answer        Json
  isCorrect     Boolean
  timeSpentMs   Int
  hintsUsed     Int      @default(0)
  attemptNumber Int      @default(1)
  errorType     String?
  submission    Submission @relation(fields: [submissionId], references: [id])
  question      Question   @relation(fields: [questionId], references: [id])
}

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  masteryRecords    StudentConceptMastery[]
  behavioralProfile StudentBehavioralProfile?
  interactionEvents InteractionEvent[]
  sessions          LearningSession[]
}

model StudentConceptMastery {
  id                 String         @id @default(cuid())
  studentId          String
  curriculumNodeId   String
  masteryLevel       Float          @default(0.0)
  confidence         Float          @default(0.0)
  totalAttempts      Int            @default(0)
  correctAttempts    Int            @default(0)
  avgTimePerQuestion Float?
  errorPatternCounts Json           @default("{}")
  hintUsageRate      Float          @default(0.0)
  lastPracticedAt    DateTime?
  streak             Int            @default(0)
  decayFactor        Float          @default(0.05)
  updatedAt          DateTime       @updatedAt

  student        StudentProfile @relation(fields: [studentId], references: [id])
  curriculumNode CurriculumNode @relation(fields: [curriculumNodeId], references: [id])

  @@unique([studentId, curriculumNodeId])
  @@index([studentId])
  @@index([curriculumNodeId])
}

model StudentBehavioralProfile {
  id                String   @id @default(cuid())
  studentId         String   @unique
  curiosityScore    Float    @default(0.5)
  motivationScore   Float    @default(0.5)
  engagementScore   Float    @default(0.5)
  persistenceScore  Float    @default(0.5)
  curiositySignals  Json     @default("{}")
  motivationSignals Json     @default("{}")
  engagementSignals Json     @default("{}")
  window30d         Json     @default("{}")
  updatedAt         DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id])
}

model InteractionEvent {
  id         String   @id @default(cuid())
  studentId  String
  sessionId  String?
  eventType  String
  timestamp  DateTime @default(now())
  questionId String?
  payload    Json

  student  StudentProfile   @relation(fields: [studentId], references: [id])
  question Question?        @relation(fields: [questionId], references: [id])
  session  LearningSession? @relation(fields: [sessionId], references: [id])

  @@index([studentId, timestamp])
  @@index([studentId, eventType])
}

model LearningSession {
  id           String    @id @default(cuid())
  studentId    String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  assignmentId String?
  sessionType  String

  student StudentProfile     @relation(fields: [studentId], references: [id])
  events  InteractionEvent[]

  @@index([studentId, startedAt])
}
